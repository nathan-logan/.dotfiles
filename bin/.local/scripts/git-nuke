#!/usr/bin/env bash
# Delete a branch both locally and on origin.
set -euo pipefail

if [[ $# -ne 1 || -z "${1:-}" ]]; then
  echo "usage: git nuke <branch>" >&2
  exit 1
fi

branch="$1"

red=$'\033[31m'
green=$'\033[32m'
dim=$'\033[2m'
reset=$'\033[0m'

# Refuse to nuke the branch you're standing on.
current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || current=""
if [[ "${branch}" == "${current}" ]]; then
  echo "${red}error: refusing to delete the currently checked-out branch '${branch}'${reset}" >&2
  exit 1
fi

# Guard against nuking the main branch.
main_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/origin/||') || true
if [[ -n "${main_ref}" && "${branch}" == "${main_ref}" ]]; then
  echo "${red}error: refusing to delete the main branch '${branch}'${reset}" >&2
  exit 1
fi

printf "%sAbout to delete branch '%s' locally and on origin.%s\n" "${dim}" "${branch}" "${reset}"
read -r -p "Continue? [y/N] " reply
if [[ ! "${reply}" =~ ^[Yy]$ ]]; then
  echo "aborted"
  exit 0
fi

if git show-ref --verify --quiet "refs/heads/${branch}"; then
  git branch -D "${branch}"
  echo "${green}deleted local ${branch}${reset}"
else
  echo "${dim}no local branch ${branch}${reset}"
fi

if git ls-remote --exit-code --heads origin "${branch}" >/dev/null 2>&1; then
  git push origin --delete "${branch}"
  echo "${green}deleted origin/${branch}${reset}"
else
  echo "${dim}no remote branch origin/${branch}${reset}"
fi
